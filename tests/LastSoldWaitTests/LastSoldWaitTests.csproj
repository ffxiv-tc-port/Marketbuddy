        <Compile Include="../../Marketbuddy/LastSoldWaitPolicy.cs" Link="LastSoldWaitPolicy.cs" />
        <Compile Include="../../Marketbuddy/LastSoldRequestQueue.cs" Link="LastSoldRequestQueue.cs" />
    </ItemGroup>
</Project>
