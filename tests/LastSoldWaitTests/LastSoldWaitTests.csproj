<Project Sdk="Microsoft.NET.Sdk">
    <!-- 離線情境測試：只編 LastSoldWaitPolicy.cs（等待上限與斷路器）、LastSoldRequestQueue.cs（查詢佇列）兩個純邏輯檔，不引用 Dalamud。
         不在 Marketbuddy.sln 裡，CI 只建 Marketbuddy/Marketbuddy.csproj，不會碰到它。
         執行方式寫在 Program.cs 開頭。 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
