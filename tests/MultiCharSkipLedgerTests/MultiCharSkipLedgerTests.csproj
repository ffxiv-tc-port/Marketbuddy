<Project Sdk="Microsoft.NET.Sdk">
    <!-- 離線情境測試：只編 MultiCharSkipLedger.cs 這一個純邏輯檔，不引用 Dalamud。
         不在 Marketbuddy.sln 裡，CI 只建 Marketbuddy/Marketbuddy.csproj，不會碰到它。
         LedgerSource 可指到別的檔（給突變體驗證用），預設是正式那份。 -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <ImplicitUsings>disable</ImplicitUsings>
        <LedgerSource Condition="'$(LedgerSource)' == ''">../../Marketbuddy/MultiCharSkipLedger.cs</LedgerSource>
    </PropertyGroup>
    <ItemGroup>
        <Compile Include="$(LedgerSource)" Link="MultiCharSkipLedger.cs" />
    </ItemGroup>
</Project>
